{
  "name": "tubepro",
  "version": "1.0.0",
  "private": true,
  "description": "Independent YouTube playback with automatic native fallback.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "lint": "eslint src scripts tests playwright.config.js",
    "format": "prettier --write src scripts tests *.js *.json *.md",
    "format:check": "prettier --check src scripts tests *.js *.json *.md"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "mp4box": "^2.5.0",
    "shaka-player": "^5.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
